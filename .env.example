# Server-only OpenAI key. Do not use NEXT_PUBLIC_ or commit a real key.
# Endpoint: https://api.openai.com/v1/chat/completions, model: gpt-5.6-luna.
OPENAI_API_KEY=

# Kakao Developers JavaScript key (public SDK key, never a REST/admin key).
# The server passes it to the browser SDK, so it remains publicly visible even
# without NEXT_PUBLIC_. Register the production domain in Kakao Developers.
KAKAO_JAVASCRIPT_KEY=
# Existing deployments using the Next.js public prefix remain supported.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Server-only 3-day shared-report storage. Current Vercel Upstash integrations
# inject the KV_* pair. Never expose any token through a NEXT_PUBLIC_ variable.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Direct Upstash credentials are accepted as a fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
