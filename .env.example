# Server-only OpenAI key. Do not use NEXT_PUBLIC_ or commit a real key.
# Endpoint: https://api.openai.com/v1/chat/completions, model: gpt-5.6-luna.
OPENAI_API_KEY=

# Kakao Developers JavaScript key (public SDK key, never a REST/admin key).
# Register https://otaku-saju-web.vercel.app in JavaScript SDK domains and
# Product Link Management before enabling KakaoTalk sharing in production.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Server-only 3-day shared-report storage, created by a Vercel Upstash Redis
# integration. Never expose either value through a NEXT_PUBLIC_ variable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
